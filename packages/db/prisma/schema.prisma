// CPFA database schema
// Source of truth for the architecture: docs/projet.md §3.2
//
// Conventions:
// - All money amounts are stored in FCFA as Int (no decimals).
// - All timestamps in UTC; UI applies Africa/Dakar tz.
// - Soft-delete is intentionally NOT used; AuditLog records destructive ops.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity & access
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  VISITEUR
  CANDIDAT
  ABONNE_BIBLIOTHEQUE
  FORMATEUR
  EDITEUR
  BIBLIOTHECAIRE
  COMPTABLE
  ADMIN
  SUPER_ADMIN
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerifiedAt DateTime?
  phone           String?   @unique
  passwordHash    String?
  firstName       String?
  lastName        String?
  avatarUrl       String?
  locale          String    @default("fr")
  twoFactorEnabled Boolean  @default(false)
  twoFactorSecret String?
  roles           Role[]    @default([VISITEUR])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  subscriptions   Subscription[]
  loans           Loan[]
  registrations   Registration[]
  payments        Payment[]
  invoices        Invoice[]
  authoredArticles Article[] @relation("ArticleAuthor")
  uploadedMedia   Media[]   @relation("MediaUploader")
  auditLogs       AuditLog[]
  trainerProfile  TrainerProfile?

  @@index([createdAt])
}

// Auth.js v5 adapter models

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────────────────────
// Library
// ─────────────────────────────────────────────────────────────────────────────

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

model Subscription {
  id          String             @id @default(cuid())
  userId      String
  cardNumber  String             @unique
  status      SubscriptionStatus @default(PENDING)
  startedAt   DateTime?
  expiresAt   DateTime?
  cardPdfKey  String?
  qrPayload   String             @unique
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user        User               @relation(fields: [userId], references: [id])
  loans       Loan[]
  payments    Payment[]

  @@index([userId])
  @@index([status])
}

model Category {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  parentId  String?
  parent    Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryParent")
  resources Resource[]
}

enum ResourceKind {
  BOOK
  JOURNAL
  THESIS
  AUDIO
  VIDEO
  DIGITAL
  OTHER
}

model Resource {
  id            String       @id @default(cuid())
  kind          ResourceKind @default(BOOK)
  title         String
  subtitle      String?
  authors       String[]
  isbn          String?
  publisher     String?
  publishedYear Int?
  language      String       @default("fr")
  summary       String?      @db.Text
  coverKey      String?
  totalCopies   Int          @default(1)
  qrPayload     String       @unique
  keywords      String[]
  categoryId    String?
  category      Category?    @relation(fields: [categoryId], references: [id])
  loans         Loan[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([title])
  @@index([categoryId])
}

enum LoanStatus {
  ACTIVE
  RETURNED
  OVERDUE
  LOST
}

model Loan {
  id              String       @id @default(cuid())
  resourceId      String
  userId          String
  subscriptionId  String
  status          LoanStatus   @default(ACTIVE)
  borrowedAt      DateTime     @default(now())
  dueAt           DateTime
  returnedAt      DateTime?
  penaltyAmount   Int          @default(0) // FCFA
  notes           String?

  resource        Resource     @relation(fields: [resourceId], references: [id])
  user            User         @relation(fields: [userId], references: [id])
  subscription    Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([userId])
  @@index([resourceId])
  @@index([status, dueAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Training
// ─────────────────────────────────────────────────────────────────────────────

enum CourseKind {
  DIPLOMANT
  CERTIFIANT
  CARTE
  AUDITORAT
}

enum CourseLevel {
  INITIATION
  INTERMEDIAIRE
  AVANCE
}

model Course {
  id          String      @id @default(cuid())
  slug        String      @unique
  title       String
  kind        CourseKind  @default(DIPLOMANT)
  level       CourseLevel @default(INITIATION)
  durationHours Int
  priceXof    Int         // FCFA
  brochureKey String?
  description String?     @db.Text
  published   Boolean     @default(false)
  modules     Module[]
  sessions    CourseSession[]
  registrations Registration[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Module {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  position  Int
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]

  @@unique([courseId, position])
}

model Lesson {
  id        String   @id @default(cuid())
  moduleId  String
  title     String
  position  Int
  content   String?  @db.Text
  durationMinutes Int?
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, position])
}

model CourseSession {
  id        String   @id @default(cuid())
  courseId  String
  startsAt  DateTime
  endsAt    DateTime
  location  String?
  capacity  Int      @default(30)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  registrations Registration[]

  @@index([courseId, startsAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Seminars / Exams / Registrations
// ─────────────────────────────────────────────────────────────────────────────

model Speaker {
  id        String    @id @default(cuid())
  fullName  String
  title     String?
  bio       String?   @db.Text
  photoKey  String?
  seminars  Seminar[] @relation("SeminarSpeakers")
}

model Seminar {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  startsAt    DateTime
  endsAt      DateTime
  location    String?
  priceXof    Int        @default(0)
  capacity    Int        @default(50)
  description String?    @db.Text
  brochureKey String?
  published   Boolean    @default(false)
  speakers    Speaker[]  @relation("SeminarSpeakers")
  registrations Registration[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

enum ExamKind {
  CONCOURS
  EXAM_BLANC
  CERTIFICATION
}

model Exam {
  id          String         @id @default(cuid())
  slug        String         @unique
  kind        ExamKind       @default(CONCOURS)
  title       String
  openAt      DateTime
  closeAt     DateTime
  examAt      DateTime?
  feeXof      Int            @default(0)
  description String?        @db.Text
  noticeKey   String?
  published   Boolean        @default(false)
  registrations Registration[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

enum RegistrationStatus {
  DRAFT
  SUBMITTED
  PAID
  VALIDATED
  REJECTED
  CANCELLED
}

model Registration {
  id          String              @id @default(cuid())
  userId      String
  status      RegistrationStatus  @default(DRAFT)
  // exactly one of the three relations is set
  courseId    String?
  sessionId   String?
  seminarId   String?
  examId      String?
  attachments Attachment[]
  paymentId   String?             @unique
  notes       String?
  submittedAt DateTime?
  validatedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  user        User                @relation(fields: [userId], references: [id])
  course      Course?             @relation(fields: [courseId], references: [id])
  session     CourseSession?      @relation(fields: [sessionId], references: [id])
  seminar     Seminar?            @relation(fields: [seminarId], references: [id])
  exam        Exam?               @relation(fields: [examId], references: [id])
  payment     Payment?            @relation(fields: [paymentId], references: [id])

  @@index([userId, status])
  @@index([courseId])
  @@index([seminarId])
  @@index([examId])
}

model Attachment {
  id              String       @id @default(cuid())
  registrationId  String
  label           String
  storageKey      String
  mimeType        String
  sizeBytes       Int
  uploadedAt      DateTime     @default(now())

  registration    Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Payments & invoices
// ─────────────────────────────────────────────────────────────────────────────

enum PaymentProvider {
  WAVE
  ORANGE_MONEY
  STATIC_QR
  CASH
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

enum PaymentPurpose {
  COURSE_REGISTRATION
  SEMINAR_REGISTRATION
  EXAM_FEE
  LIBRARY_SUBSCRIPTION
  LIBRARY_PENALTY
  OTHER
}

model Payment {
  id              String          @id @default(cuid())
  userId          String
  amountXof       Int             // FCFA
  currency        String          @default("XOF")
  provider        PaymentProvider
  providerRef     String?         @unique
  status          PaymentStatus   @default(PENDING)
  purpose         PaymentPurpose
  subscriptionId  String?
  metadata        Json?
  receivedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user            User            @relation(fields: [userId], references: [id])
  subscription    Subscription?   @relation(fields: [subscriptionId], references: [id])
  registration    Registration?
  invoice         Invoice?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Invoice {
  id          String   @id @default(cuid())
  number      String   @unique
  userId      String
  paymentId   String   @unique
  amountXof   Int
  pdfKey      String?
  issuedAt    DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
  payment     Payment  @relation(fields: [paymentId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// CMS (institutional site)
// ─────────────────────────────────────────────────────────────────────────────

model Page {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  locale      String   @default("fr")
  content     Json     // block-based content
  metaTitle   String?
  metaDescription String?
  published   Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([slug, locale])
}

model Article {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String?  @db.Text
  content     Json
  coverKey    String?
  authorId    String
  locale      String   @default("fr")
  published   Boolean  @default(false)
  publishedAt DateTime?
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author      User     @relation("ArticleAuthor", fields: [authorId], references: [id])

  @@index([published, publishedAt])
}

model Media {
  id          String   @id @default(cuid())
  storageKey  String   @unique
  mimeType    String
  sizeBytes   Int
  width       Int?
  height      Int?
  altText     String?
  uploadedById String
  uploadedAt  DateTime @default(now())

  uploadedBy  User     @relation("MediaUploader", fields: [uploadedById], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// Trainers
// ─────────────────────────────────────────────────────────────────────────────

model TrainerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  bio         String?  @db.Text
  domains     String[]
  cvKey       String?
  approved    Boolean  @default(false)

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────────
// Audit log (immutable)
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  diff      Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  actor     User?    @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([actorId, createdAt])
}
