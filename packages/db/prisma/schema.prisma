// CPFA database schema
// Source of truth for the architecture: docs/projet.md §3.2
//
// Conventions:
// - All money amounts are stored in FCFA as Int (no decimals).
// - All timestamps in UTC; UI applies Africa/Dakar tz.
// - Soft-delete is intentionally NOT used; AuditLog records destructive ops.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity & access
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  VISITEUR
  CANDIDAT
  ABONNE_BIBLIOTHEQUE
  FORMATEUR
  EDITEUR
  BIBLIOTHECAIRE
  COMPTABLE
  ADMIN
  SUPER_ADMIN
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerifiedAt DateTime?
  phone           String?   @unique
  passwordHash    String?
  firstName       String?
  lastName        String?
  avatarUrl       String?
  locale          String    @default("fr")
  twoFactorEnabled Boolean  @default(false)
  twoFactorSecret String?
  roles           Role[]    @default([VISITEUR])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  subscriptions   Subscription[]
  loans           Loan[]
  registrations   Registration[]
  payments        Payment[]
  invoices        Invoice[]
  authoredArticles Article[] @relation("ArticleAuthor")
  uploadedMedia   Media[]   @relation("MediaUploader")
  auditLogs       AuditLog[]
  trainerProfile  TrainerProfile? @relation("TrainerProfileUser")
  reviewedTrainers TrainerProfile[] @relation("TrainerProfileReviewer")
  uploadedTrainerResources TrainerResource[] @relation("TrainerResourceUploader")
  coachedSessions  CourseSession[]  @relation("CourseSessionTrainer")
  updatedSiteSettings SiteSetting[]  @relation("SiteSettingUpdater")
  jobPostings      JobPosting[]     @relation("JobPostingRecruiter")
  jobApplications  JobApplication[] @relation("JobApplicationCandidate")

  @@index([createdAt])
}

// Auth.js v5 adapter models

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────────────────────
// Library
// ─────────────────────────────────────────────────────────────────────────────

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

model Subscription {
  id          String             @id @default(cuid())
  userId      String
  cardNumber  String             @unique
  // Three formules — see lib/library-rules.ts (LIBRARY_TIERS).
  // STUDENT 10k/an · PROFESSIONAL 15k/an · HOME_LOAN 50k/an (emprunt domicile).
  tier        SubscriptionTier   @default(PROFESSIONAL)
  status      SubscriptionStatus @default(PENDING)
  startedAt   DateTime?
  expiresAt   DateTime?
  cardPdfKey  String?
  qrPayload   String             @unique
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user        User               @relation(fields: [userId], references: [id])
  loans       Loan[]
  payments    Payment[]

  @@index([userId])
  @@index([status])
}

enum SubscriptionTier {
  STUDENT
  PROFESSIONAL
  HOME_LOAN
}

model Category {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  parentId  String?
  parent    Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryParent")
  resources Resource[]
}

enum ResourceKind {
  BOOK
  JOURNAL
  THESIS
  AUDIO
  VIDEO
  DIGITAL
  OTHER
}

model Resource {
  id            String       @id @default(cuid())
  kind          ResourceKind @default(BOOK)
  title         String
  subtitle      String?
  authors       String[]
  isbn          String?
  publisher     String?
  publishedYear Int?
  language      String       @default("fr")
  summary       String?      @db.Text
  coverKey      String?
  totalCopies   Int          @default(1)
  qrPayload     String       @unique
  keywords      String[]
  categoryId    String?
  category      Category?    @relation(fields: [categoryId], references: [id])
  loans         Loan[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([title])
  @@index([categoryId])
}

enum LoanStatus {
  ACTIVE
  RETURNED
  OVERDUE
  LOST
}

model Loan {
  id              String       @id @default(cuid())
  resourceId      String
  userId          String
  subscriptionId  String
  status          LoanStatus   @default(ACTIVE)
  borrowedAt      DateTime     @default(now())
  dueAt           DateTime
  returnedAt      DateTime?
  penaltyAmount   Int          @default(0) // FCFA
  notes           String?

  resource        Resource     @relation(fields: [resourceId], references: [id])
  user            User         @relation(fields: [userId], references: [id])
  subscription    Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([userId])
  @@index([resourceId])
  @@index([status, dueAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Training
// ─────────────────────────────────────────────────────────────────────────────

enum CourseKind {
  DIPLOMANT
  CERTIFIANT
  CARTE
  AUDITORAT
}

enum CourseLevel {
  INITIATION
  INTERMEDIAIRE
  AVANCE
}

model Course {
  id          String      @id @default(cuid())
  slug        String      @unique
  title       String
  kind        CourseKind  @default(DIPLOMANT)
  level       CourseLevel @default(INITIATION)
  durationHours Int
  priceXof    Int         // FCFA
  brochureKey String?
  coverImageKey String?
  description String?     @db.Text
  published   Boolean     @default(false)
  // Application window — `registrations.create` rejects new applications
  // outside [applicationsOpenAt, applicationsCloseAt]. Both NULL means the
  // form is always open. Used for diplômantes (DTA, BTS) gated by concours.
  applicationsOpenAt   DateTime?
  applicationsCloseAt  DateTime?
  modules     Module[]
  sessions    CourseSession[]
  registrations Registration[]
  trainerResources TrainerResource[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Module {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  position  Int
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]
  trainerResources TrainerResource[]

  @@unique([courseId, position])
}

model Lesson {
  id        String   @id @default(cuid())
  moduleId  String
  title     String
  position  Int
  content   String?  @db.Text
  durationMinutes Int?
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, position])
}

model CourseSession {
  id        String   @id @default(cuid())
  courseId  String
  trainerId String?
  startsAt  DateTime
  endsAt    DateTime
  location  String?
  capacity  Int      @default(30)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  trainer   User?    @relation("CourseSessionTrainer", fields: [trainerId], references: [id], onDelete: SetNull)
  registrations Registration[]

  @@index([courseId, startsAt])
  @@index([trainerId, startsAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Seminars / Exams / Registrations
// ─────────────────────────────────────────────────────────────────────────────

model Speaker {
  id        String    @id @default(cuid())
  fullName  String
  title     String?
  bio       String?   @db.Text
  photoKey  String?
  seminars  Seminar[] @relation("SeminarSpeakers")
}

model Seminar {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  startsAt    DateTime
  endsAt      DateTime
  location    String?
  priceXof    Int        @default(0)
  capacity    Int        @default(50)
  description String?    @db.Text
  brochureKey String?
  published   Boolean    @default(false)
  speakers    Speaker[]  @relation("SeminarSpeakers")
  registrations Registration[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

enum ExamKind {
  CONCOURS
  EXAM_BLANC
  CERTIFICATION
}

model Exam {
  id          String         @id @default(cuid())
  slug        String         @unique
  kind        ExamKind       @default(CONCOURS)
  title       String
  openAt      DateTime
  closeAt     DateTime
  examAt      DateTime?
  feeXof      Int            @default(0)
  description String?        @db.Text
  noticeKey   String?
  published   Boolean        @default(false)
  registrations Registration[]
  papers      ExamPaper[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

enum ExamPaperAccess {
  PUBLIC          // anyone (sample papers)
  REGISTERED      // SUBMITTED+ on the same exam
  PAID            // PAID/VALIDATED on the same exam (default — protected bank)
}

// Past exam papers / sample papers / official notices.
// Access is gated by `accessLevel` on the application side via tRPC.
model ExamPaper {
  id          String          @id @default(cuid())
  examId      String
  title       String
  year        Int?
  fileKey     String          // S3 object key
  mimeType    String          @default("application/pdf")
  sizeBytes   Int?
  accessLevel ExamPaperAccess @default(PAID)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  exam        Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId, year])
}

enum RegistrationStatus {
  DRAFT
  SUBMITTED
  PAID
  VALIDATED
  REJECTED
  CANCELLED
}

model Registration {
  id          String              @id @default(cuid())
  userId      String
  status      RegistrationStatus  @default(DRAFT)
  // exactly one of the three relations is set
  courseId    String?
  sessionId   String?
  seminarId   String?
  examId      String?
  attachments Attachment[]
  paymentId   String?             @unique
  notes       String?
  submittedAt DateTime?
  validatedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  user        User                @relation(fields: [userId], references: [id])
  course      Course?             @relation(fields: [courseId], references: [id])
  session     CourseSession?      @relation(fields: [sessionId], references: [id])
  seminar     Seminar?            @relation(fields: [seminarId], references: [id])
  exam        Exam?               @relation(fields: [examId], references: [id])
  payment     Payment?            @relation(fields: [paymentId], references: [id])

  @@index([userId, status])
  @@index([courseId])
  @@index([seminarId])
  @@index([examId])
}

model Attachment {
  id              String       @id @default(cuid())
  registrationId  String
  label           String
  storageKey      String
  mimeType        String
  sizeBytes       Int
  uploadedAt      DateTime     @default(now())

  registration    Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Payments & invoices
// ─────────────────────────────────────────────────────────────────────────────

enum PaymentProvider {
  WAVE
  ORANGE_MONEY
  PAYTECH
  STATIC_QR
  CASH
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

enum PaymentPurpose {
  COURSE_REGISTRATION
  SEMINAR_REGISTRATION
  EXAM_FEE
  LIBRARY_SUBSCRIPTION
  LIBRARY_PENALTY
  OTHER
}

model Payment {
  id              String          @id @default(cuid())
  userId          String
  amountXof       Int             // FCFA
  currency        String          @default("XOF")
  provider        PaymentProvider
  providerRef     String?         @unique
  status          PaymentStatus   @default(PENDING)
  purpose         PaymentPurpose
  subscriptionId  String?
  metadata        Json?
  receivedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user            User            @relation(fields: [userId], references: [id])
  subscription    Subscription?   @relation(fields: [subscriptionId], references: [id])
  registration    Registration?
  invoice         Invoice?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Invoice {
  id          String   @id @default(cuid())
  number      String   @unique
  userId      String
  paymentId   String   @unique
  amountXof   Int
  pdfKey      String?
  issuedAt    DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
  payment     Payment  @relation(fields: [paymentId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// CMS (institutional site)
// ─────────────────────────────────────────────────────────────────────────────

// Job board (§3.2 du doc Directeur).
//
// Modèle anti-spam : n'importe qui peut soumettre une offre via le form public,
// elle est créée en DRAFT ; un admin (`cms:write`) bascule à PUBLISHED ou
// REJECTED après revue. Les candidatures vont à l'email recruteur de l'offre.
model JobPosting {
  id              String              @id @default(cuid())
  recruiterId     String?
  recruiterEmail  String              // Toujours présent — destinataire des notifs candidature.
  companyName     String
  title           String
  description     String              @db.Text
  profile         String              @db.Text
  contact         String              // Tel / email / adresse libre côté entreprise.
  fileSheetKey    String?
  type            JobType             @default(CDI)
  level           JobLevel            @default(JUNIOR)
  location        String?
  urgent          Boolean             @default(false)
  status          JobStatus           @default(DRAFT)
  closesAt        DateTime?
  publishedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  recruiter       User?               @relation("JobPostingRecruiter", fields: [recruiterId], references: [id])
  applications    JobApplication[]

  @@index([status, closesAt])
}

enum JobType {
  CDI
  CDD
  STAGE
  FREELANCE
  ALTERNANCE
}

enum JobLevel {
  JUNIOR
  INTERMEDIAIRE
  SENIOR
  EXECUTIVE
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  REJECTED
}

model JobApplication {
  id              String              @id @default(cuid())
  jobPostingId    String
  candidateUserId String?
  firstName       String
  lastName        String
  email           String
  phone           String?
  motivation      String              @db.Text
  cvKey           String
  status          JobApplicationStatus @default(SUBMITTED)
  createdAt       DateTime            @default(now())

  jobPosting      JobPosting          @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  candidate       User?               @relation("JobApplicationCandidate", fields: [candidateUserId], references: [id])

  @@index([jobPostingId])
}

enum JobApplicationStatus {
  SUBMITTED
  REVIEWED
  REJECTED
  ACCEPTED
}

// Témoignages affichés sur la home, /enseigner-au-cpfa et /espaces-apprenants.
// Le scope distingue les voix (étudiants, profs, pros, partenaires).
// `displayOrder` (croissant) gouverne l'ordre dans le carrousel ; à défaut on
// se rabat sur `createdAt` desc.
model Testimonial {
  id             String          @id @default(cuid())
  scope          TestimonialScope
  authorName     String
  authorRole     String?
  authorPhotoKey String?
  quote          String          @db.Text
  locale         String          @default("fr")
  published      Boolean         @default(false)
  displayOrder   Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([published, locale, scope, displayOrder])
}

enum TestimonialScope {
  STUDENT
  TEACHER
  PROFESSIONAL
  PARTNER
}

// Key-value site-wide settings. Each known key has a typed schema enforced
// in the application layer (apps/web/src/lib/site-settings/registry.ts) —
// the DB stores the raw JSON. Used for content that doesn't fit in a Page
// (homepage testimonials, hero copy, footer info, governance/stats lists).
//
// Locale-aware: each (key, locale) pair stores an independent value so the
// editor can localise content per language. Reads fall back to the default
// locale when no row exists for the requested locale.
model SiteSetting {
  key           String
  locale        String   @default("fr")
  value         Json
  updatedAt     DateTime @updatedAt
  updatedById   String?

  updatedBy     User?    @relation("SiteSettingUpdater", fields: [updatedById], references: [id])

  @@id([key, locale])
}

model Page {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  locale      String   @default("fr")
  content     Json     // block-based content
  metaTitle   String?
  metaDescription String?
  published   Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([slug, locale])
}

model Article {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String?  @db.Text
  content     Json
  coverKey    String?
  authorId    String
  locale      String   @default("fr")
  published   Boolean  @default(false)
  publishedAt DateTime?
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author      User     @relation("ArticleAuthor", fields: [authorId], references: [id])

  @@index([published, publishedAt])
}

model Media {
  id          String   @id @default(cuid())
  storageKey  String   @unique
  mimeType    String
  sizeBytes   Int
  width       Int?
  height      Int?
  altText     String?
  uploadedById String
  uploadedAt  DateTime @default(now())

  uploadedBy  User     @relation("MediaUploader", fields: [uploadedById], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// Trainers
// ─────────────────────────────────────────────────────────────────────────────

model TrainerProfile {
  id              String         @id @default(cuid())
  userId          String         @unique
  bio             String?        @db.Text
  domains         String[]
  cvKey           String?
  phone           String?
  experienceYears Int?
  status          TrainerStatus  @default(PENDING)
  submittedAt     DateTime       @default(now())
  reviewedAt      DateTime?
  reviewedById    String?
  rejectionReason String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user            User           @relation("TrainerProfileUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy      User?          @relation("TrainerProfileReviewer", fields: [reviewedById], references: [id])

  @@index([status])
}

enum TrainerStatus {
  PENDING
  APPROVED
  REJECTED
}

// Pedagogical resources visible to all approved trainers. Uploaded by an
// editor/admin with `trainer:manage`; downloadable via presigned GET by any
// FORMATEUR. Optional course/module scoping for organisation in the UI.
model TrainerResource {
  id            String    @id @default(cuid())
  title         String
  description   String?   @db.Text
  storageKey    String
  mimeType      String
  sizeBytes     Int
  courseId      String?
  moduleId      String?
  uploadedById  String
  createdAt     DateTime  @default(now())

  uploadedBy    User      @relation("TrainerResourceUploader", fields: [uploadedById], references: [id])
  course        Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  module        Module?   @relation(fields: [moduleId], references: [id], onDelete: SetNull)

  @@index([courseId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Audit log (immutable)
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  diff      Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  actor     User?    @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([actorId, createdAt])
}
