# --- Application ---
NODE_ENV=development
APP_URL=http://localhost:3000

# --- Auth.js v5 ---
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# Optional providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Database (Postgres) ---
DATABASE_URL=postgresql://cpfa:cpfa@localhost:5432/cpfa?schema=public

# --- Redis (BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Object storage (S3-compatible) ---
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=cpfa
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# --- Email (Resend or Postmark) ---
EMAIL_FROM="CPFA <noreply@cpfa.local>"
RESEND_API_KEY=

# --- Payments (Senegal) ---
# Default flow is static QR until merchant contracts are signed.
PAYMENT_PROVIDER=static-qr
WAVE_API_KEY=
WAVE_MERCHANT_ID=
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=

# --- Observability ---
SENTRY_DSN=

# --- i18n ---
DEFAULT_LOCALE=fr
LOCALES=fr
