# --- Application ---
NODE_ENV=development
APP_URL=http://localhost:3000

# --- Auth.js v5 ---
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# Optional providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Database (Postgres) ---
DATABASE_URL=postgresql://cpfa:cpfa@localhost:5432/cpfa?schema=public

# --- Redis (BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Local file storage ---
# Directory where uploaded and generated files are stored (relative to the
# app working directory, or an absolute path). Must be writable and persisted
# (Docker volume in production). Defaults to ./storage if unset.
STORAGE_DIR=./storage
# Secret used to sign upload/download URLs. Falls back to AUTH_SECRET if unset.
STORAGE_SECRET=

# --- Email (Resend or Postmark) ---
EMAIL_FROM="CPFA <noreply@cpfa.local>"
RESEND_API_KEY=

# --- Payments (Senegal) ---
# Production provider is `paytech` (aggregator: Wave, Orange Money, Free Money,
# Wizall, E-money, Visa, Mastercard). `static-qr` remains as a manual fallback
# usable from /admin/payments. Decision §10.2 of docs/projet.md.
PAYMENT_PROVIDER=static-qr

# PayTech — credentials from the merchant dashboard at https://paytech.sn
PAYTECH_API_KEY=
PAYTECH_API_SECRET=
PAYTECH_ENV=test
# IPN/return URLs — the IPN must be reachable over HTTPS in prod. PayTech
# verifies its own HMAC against api_secret, so a stale/leaked URL alone
# can't confirm payments.
PAYTECH_IPN_URL=http://localhost:3000/api/webhooks/payments/paytech
PAYTECH_SUCCESS_URL=http://localhost:3000/paiement/succes
PAYTECH_CANCEL_URL=http://localhost:3000/paiement/annule

# --- Maintenance gate ---
# Signs the cookie handed out after a successful login on the maintenance page.
# Falls back to AUTH_SECRET if unset. Rotating it logs every previewer out.
# The on/off switch itself lives in the DB, editable from /admin/maintenance.
MAINTENANCE_SECRET=

# --- Observability ---
SENTRY_DSN=

# --- i18n ---
DEFAULT_LOCALE=fr
LOCALES=fr
